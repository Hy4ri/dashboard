# Dashboard environment variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Required: qBittorrent password (for torrent info in dashboard)
QB_USER=admin
QB_PASS=your_qbittorrent_password_here

# Required: API key for dashboard /api/status endpoint
# Generate a random key: openssl rand -hex 32
# This must match between server and client (injected into index.html automatically)
API_KEY=generate_your_random_api_key_here

# Optional: Port for the dashboard server (default: 8080)
# PORT=8080
# NODE_ENV=production
