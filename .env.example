# Dashboard environment variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Required: qBittorrent password (for torrent info in dashboard)
QB_USER=admin
QB_PASS=your_qbittorrent_password_here

# Optional: Port for the dashboard server (default: 8080)
# PORT=8080
# NODE_ENV=production

# Optional: Technitium DNS integration (for stats on network card)
# Generate a token in Technitium DNS under: Settings -> Users -> API Keys
# TECHNITIUM_TOKEN=your_technitium_api_token_here
# TECHNITIUM_URL=http://127.0.0.1:5380
