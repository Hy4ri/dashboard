# Dashboard environment variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Required: qBittorrent password (for torrent info in dashboard)
QB_USER=admin
QB_PASS=your_qbittorrent_password_here
# Optional: qBittorrent host and Web API port (default: localhost, 7777)
# QB_HOST=localhost
# QB_PORT=7777

# Optional: enable the login page. Both values must be set.
# AUTH_USER=admin
# AUTH_PASS=change_me

# Optional: Port for the dashboard server (default: 8080)
# PORT=8080
# NODE_ENV=production

# Optional: Technitium DNS integration (for stats on network card)
# Generate a token in Technitium DNS under: Settings -> Users -> API Keys
# TECHNITIUM_TOKEN=your_technitium_api_token_here
# TECHNITIUM_URL=http://127.0.0.1:5380

# Optional: set to true only when a trusted reverse proxy terminates TLS and
# sets X-Forwarded-Proto. Otherwise the header is ignored.
# TRUST_PROXY=false

# Optional: network interfaces to show, comma separated (default: wlan0,tun0)
# NET_IFACES=wlan0,tun0

# Optional: thermal zone names to show, comma separated
# Default: cpu-1-6-step,battery,gpuss-0-step,ddr-usr
# THERMAL_ZONES=cpu-1-6-step,battery

# Optional: directory that holds index.html and dist/ (default: executable dir)
# APP_ROOT=/opt/monit

# Optional: Claude OAuth credentials file
# CLAUDE_CREDENTIALS=/.claude/.credentials.json

# Optional: header service links and health probes, as Name:port pairs.
# Default: Jellyfin:8096,Seerr:5055,qBittorrent:7777,Sonarr:8989,Radarr:7878,
#          Prowlarr:9696,Bazarr:6767,Dufs:5050,Technitium:5380,Hermes:9119
# SERVICES=Jellyfin:8096,Hermes:9119

# Optional: Codex usage refresh interval (default: 5m). Accepts "5m" or seconds.
# CODEX_TTL=5m
