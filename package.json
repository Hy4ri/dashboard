{
  "name": "server-dashboard",
  "version": "1.0.0",
  "description": "Lightweight server status dashboard — zero dependencies",
  "main": "dist/server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "go build -mod=mod -o monit-server . && tsc -p tsconfig.client.json",
    "build:server": "go build -mod=mod -o monit-server .",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "start": "./monit-server",
    "dev": "go run main.go",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "keywords": [
    "dashboard",
    "server",
    "pm2",
    "monitor"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
