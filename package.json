{
  "name": "server-dashboard",
  "version": "1.0.0",
  "description": "Lightweight Go server dashboard with a TypeScript frontend",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:server": "go build -o monit-server .",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "test": "node tests/run.cjs",
    "test:browser": "node tests/run.cjs --browser",
    "start": "./monit-server",
    "dev": "go run main.go",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "lint": "oxlint -c oxlint.config.mjs src"
  },
  "keywords": [
    "dashboard",
    "server",
    "pm2",
    "monitor"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.60.0",
    "typescript": "^7.0.2"
  }
}
