{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/client/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/server/**/*"
  ]
}
